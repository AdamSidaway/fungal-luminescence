# Large data — never committed
data/assemblies/
data/blastdb/
*.fna
*.fna.gz
*.dmnd
*.zip
logs/*.log
__pycache__/
.ipynb_checkpoints/

# Sequences we DO commit (small, needed for reproducibility)
!data/refseqs/*.fasta
!results/**/*.fasta

# Raw per-HSP output: large and fully regenerable from the assemblies + query
# set by scripts/sweep.py. The curated loci/clusters tables and the called
# sequences are committed; this is the intermediate.
results/**/hits_raw.tsv
